{
  "name": "Salamatban visual identity",
  "version": "1.0.0",
  "locale": "fa-IR",
  "direction": "rtl",
  "provenance": {
    "palette": "Original Salamatban palette, independently designed. Direct Doctoreto brand values were not verified.",
    "font": "Nine PeydaWebFaNum WOFF2 weights supplied by project owner."
  },
  "color": {
    "primary": "#1677D2",
    "primaryHover": "#0D5EAD",
    "primaryDeep": "#08477F",
    "primarySoft": "#EAF4FF",
    "primaryBorder": "#BFDCF5",
    "teal": "#14A89B",
    "tealInk": "#087F76",
    "tealSoft": "#E9F8F5",
    "ink": "#18344D",
    "inkDeep": "#102A43",
    "muted": "#60758A",
    "canvas": "#F4F8FC",
    "surface": "#FFFFFF",
    "surfaceAlt": "#F8FBFE",
    "border": "#D7E4EF",
    "controlBorder": "#7891A8",
    "success": "#15734B",
    "successSoft": "#EAF7EF",
    "warning": "#865809",
    "warningSoft": "#FFF5DF",
    "danger": "#B33C44",
    "dangerSoft": "#FFF0F1",
    "info": "#0D5EAD",
    "infoSoft": "#EAF4FF",
    "focus": "#0D5EAD"
  },
  "font": {
    "family": "Peyda",
    "internalFamily": "PeydaWeb(FaNum)",
    "fallbacks": [
      "Tahoma",
      "Arial",
      "sans-serif"
    ],
    "weight": {
      "thin": 100,
      "extraLight": 200,
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semiBold": 600,
      "bold": 700,
      "extraBold": 800,
      "black": 900
    },
    "scale": {
      "display": {
        "size": 48,
        "weight": 800,
        "lineHeight": 1.4
      },
      "heading1": {
        "size": 32,
        "mobileSize": 26,
        "weight": 800,
        "lineHeight": 1.4
      },
      "heading2": {
        "size": 22,
        "weight": 700,
        "lineHeight": 1.5
      },
      "body": {
        "size": 16,
        "weight": 400,
        "lineHeight": 1.9
      },
      "label": {
        "size": 14,
        "weight": 600,
        "lineHeight": 1.7
      },
      "caption": {
        "size": 12,
        "weight": 400,
        "lineHeight": 1.8
      }
    }
  },
  "spacing": {
    "unit": "px",
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48
  },
  "radius": {
    "unit": "px",
    "small": 10,
    "medium": 16,
    "large": 24
  },
  "shadow": {
    "small": "0 4px 16px #18344D06",
    "medium": "0 14px 42px #18344D0B",
    "large": "0 28px 72px #18344D12"
  },
  "icon": {
    "viewBox": "0 0 24 24",
    "strokeWidth": 1.8,
    "lineCap": "round",
    "lineJoin": "round",
    "defaultSize": 20
  },
  "accessibility": {
    "bodyContrastMinimum": 4.5,
    "largeTextContrastMinimum": 3,
    "touchTargetMinimumPx": 44,
    "focusOutlinePx": 3,
    "focusOffsetPx": 4,
    "tealUse": "Use tealInk for small text. Teal is decorative accent, not white text background."
  },
  "format": "Salamatban semantic design tokens v1"
}
